    "lit": "^3.2.1",
    "xstate": "6.0.0-alpha.40",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "concurrently": "9.2.1",
    "mdtask": "0.1.17",
    "tsx": "4.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.0.7"
  },
  "packageManager": "pnpm@10.2.0"
}
