{
  "name": "tutu-diff-hackaton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env --import tsx --watch src/server/main.ts\"",
